set -xe

useradd fedora
usermod fedora -a -G wheel
printf 'fedora\nfedora\n' | passwd fedora
passwd -l root

systemctl set-default graphical.target

mkdir staging
tar -cO afs bin boot etc home lib lib64 media opt root run sbin srv usr var | tar -C staging -x

for f in dev mnt proc sys tmp
do
	mkdir staging/$f
done

# the joysticks are not sensors
cp /work_dir/ext/armbian_build/config/optional/boards/anbernic-rg-vita-pro/_packages/bsp-cli/etc/udev/rules.d/60-vita-joypad-not-accel.rules staging/etc/udev/rules.d/

# kernel modules
cp -r /work_dir/rootfs_build/rocknix_modules_prebuilt/7.0.2 staging/usr/lib/modules/
cp -r /work_dir/rootfs_build/anbernic_modules_prebuilt/6.1.99 staging/usr/lib/modules/

# bluetooth firmware
cp -r /work_dir/ext/rocknix_distribution/projects/ROCKNIX/packages/linux-firmware/kernel-firmware/extra-firmware/rtl_bt/rtl8852bs_* staging/usr/lib/firmware/rtl_bt/

# ucm config
mkdir -p staging/usr/share/alsa/ucm2/conf.d
cp -r /work_dir/ext/rocknix_distribution/projects/ROCKNIX/packages/audio/alsa-ucm-conf/sources/ucm2/Rockchip staging/usr/share/alsa/ucm2/
cp -r /work_dir/ext/rocknix_distribution/projects/ROCKNIX/packages/audio/alsa-ucm-conf/sources/ucm2/conf.d/simple-card staging/usr/share/alsa/ucm2/conf.d/

# boot hacks
cp /work_dir/rootfs_build/vita.service staging/etc/systemd/system/
cp /work_dir/rootfs_build/vita.sh staging/usr/libexec/
mkdir -p staging/etc/systemd/system/graphical.target.wants
ln -s /etc/systemd/system/vita.service staging/etc/systemd/system/graphical.target.wants/

# dpms off suspend workaround
cp /work_dir/rootfs_build/suspend_dpms_hotfix.service staging/etc/systemd/user
cp /work_dir/rootfs_build/suspend_dpms_hotfix.py staging/usr/libexec/
mkdir -p staging/etc/systemd/user/graphical-session.target.wants
ln -s /etc/systemd/user/suspend_dpms_hotfix.service staging/etc/systemd/user/graphical-session.target.wants/

# fake suspend fallback
cp /work_dir/rootfs_build/fake_suspend.py staging/usr/libexec
cp /work_dir/rootfs_build/fake_suspend.service staging/etc/systemd/system/

if true
then
	# libmali setup
	cp -r /work_dir/rootfs_build/libmali_g29_prebuilt/* staging/
	cp /work_dir/rootfs_build/libmali.service staging/etc/systemd/system/
	cp /work_dir/rootfs_build/libmali.sh staging/usr/libexec/
	mkdir -p staging/etc/systemd/system/multi-user.target.wants
	ln -s /etc/systemd/system/libmali.service staging/etc/systemd/system/multi-user.target.wants/

	# cannot suspend properly with mali_kbase loaded
	rm staging/etc/systemd/user/graphical-session.target.wants/suspend_dpms_hotfix.service
	ln -s /etc/systemd/system/fake_suspend.service staging/etc/systemd/system/systemd-suspend.service

	# need to work around qt rendering for nextcloud
	mkdir -p staging/usr/local/bin/
	cp /work_dir/rootfs_build/nextcloud staging/usr/local/bin/

	# fake suspend does not work well with rtkit, eg. pipewire can get killed on wake
	# this causes audio stuttering however when system is under heavy load
	ln -s /dev/null staging/etc/systemd/system/rtkit-daemon.service
fi

# controller conversion
cp /work_dir/rootfs_build/vita_controller.service staging/etc/systemd/system/
cp /work_dir/rootfs_build/vita_controller staging/usr/libexec/
mkdir -p staging/etc/systemd/user/graphical-session.target.wants
ln -s /etc/systemd/system/vita_controller.service staging/etc/systemd/user/graphical-session.target.wants/

# need to figure out proper kernel building to enable user ns
cp /usr/lib/systemd/system/upower.service staging/etc/systemd/system/
sed -i 's/PrivateUsers=yes/#PrivateUsers=yes/' staging/etc/systemd/system/upower.service 
sed -i 's/RestrictNamespaces=yes/#RestrictNamespaces=yes/' staging/etc/systemd/system/upower.service

cd staging
tar -cf ../work_dir/rootfs.tar .
